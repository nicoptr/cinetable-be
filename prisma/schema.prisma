generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int          @id @default(autoincrement())
  username        String       @unique
  email           String       @unique
  password        String
  avatarUrl       String?
  emailVerifiedAt DateTime?
  tokenVersion    Int          @default(0)
  isPlatformAdmin Boolean      @default(false)
  memberships     Membership[]
  authTokens      AuthToken[]
  sentInvitations Invitation[] @relation("InvitedBy")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Cineforum {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  memberships Membership[]
  invitations Invitation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum MembershipRole {
  PRESIDENT
  MEMBER
}

model Membership {
  id          Int            @id @default(autoincrement())
  userId      Int
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  cineforumId Int
  cineforum   Cineforum      @relation(fields: [cineforumId], references: [id], onDelete: Cascade)
  role        MembershipRole
  createdAt   DateTime       @default(now())

  @@unique([userId, cineforumId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

model Invitation {
  id          Int              @id @default(autoincrement())
  cineforumId Int
  cineforum   Cineforum        @relation(fields: [cineforumId], references: [id], onDelete: Cascade)
  email       String
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  invitedById Int
  invitedBy   User             @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([cineforumId, email])
  @@index([email])
}

enum AuthTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model AuthToken {
  id        Int           @id @default(autoincrement())
  userId    Int
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
}
