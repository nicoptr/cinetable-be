NODE_ENV=test

# Server
HOST=0.0.0.0
PORT=5055
CLIENT_URL=http://localhost:3055
# Numero di proxy fidati davanti al backend (hop count) oppure false; "true" non è valido.
# Negli e2e l'unico proxy è Next (porta 3055): Next inoltra l'X-Forwarded-For del client così com'è,
# quindi con 1 il backend fida il solo socket di Next e legge l'ultima voce dell'X-Forwarded-For,
# cioè il valore diverso che e2e/helpers.ts manda per ogni test. Con false tutti i test
# condividerebbero l'IP di Next (e i rate limit per IP si sommerebbero).
TRUST_PROXY=1

# Auth
# JWT_SECRET: almeno 32 caratteri casuali (obbligatorio in production)
JWT_SECRET=test-secret-test-secret-test-secret
SALT_ROUNDS=4

# Database
DATABASE_URL="postgresql://nicola:nicola@localhost:5432/cinofili_e2e?schema=public"

GOD_USERNAME=god
GOD_EMAIL=god@gmail.com
GOD_PASSWORD=cambiami-subito

SEED_DB=false

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# TMDB (token "API Read Access Token" v4, obbligatorio in production)
TMDB_API_TOKEN=
TMDB_BASE_URL=https://api.themoviedb.org/3
