NODE_ENV=development

# Server
HOST=0.0.0.0
PORT=5000
CLIENT_URL="http://localhost:3000"
# Impostare a "true" dietro un reverse proxy (necessario per i rate limit per IP)
TRUST_PROXY=false

# Auth
# JWT_SECRET: almeno 32 caratteri casuali (obbligatorio in production)
JWT_SECRET=change_me_with_at_least_32_random_characters
SALT_ROUNDS=12

# Database
DATABASE_URL="postgresql://nicola:nicola@localhost:5432/cinofili?schema=public&connection_limit=5"

GOD_USERNAME=god
GOD_EMAIL=god@gmail.com
GOD_PASSWORD=cambiami-subito

SEED_DB=false

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# TMDB (token "API Read Access Token" v4, obbligatorio in production)
TMDB_API_TOKEN=
TMDB_BASE_URL=https://api.themoviedb.org/3
